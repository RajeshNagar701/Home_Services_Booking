# ==========================================
# HOMESERVE TECHNOLOGIES - BACKEND ENV CONFIG
# ==========================================

# Application Settings
PROJECT_NAME="HomeServe Technologies API"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True
PORT=8000
HOST="0.0.0.0"

# Security & Authentication
# Generate with: openssl rand -hex 32
SECRET_KEY="homeserve_super_secret_jwt_key_2026_argon2_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# MySQL Database Connection (SQLAlchemy)
# Synchronous / PyMySQL: mysql+pymysql://user:password@host:port/dbname
# Asynchronous / asyncmy: mysql+asyncmy://user:password@host:port/dbname
MYSQL_USER="root"
MYSQL_PASSWORD="your_mysql_password"
MYSQL_HOST="localhost"
MYSQL_PORT=3306
MYSQL_DB="homeserve_db"
DATABASE_URL="mysql+pymysql://root:your_mysql_password@localhost:3306/homeserve_db"

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# Razorpay Test Mode Payment Credentials
RAZORPAY_KEY_ID="rzp_test_homeserve_2026"
RAZORPAY_KEY_SECRET="your_razorpay_secret_key"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# Email Configuration (SMTP)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
EMAILS_FROM_EMAIL="notifications@homeserve.tech"
EMAILS_FROM_NAME="HomeServe Technologies"

# CORS Configuration (JSON Array format)
BACKEND_CORS_ORIGINS='["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]'
